.mcp.json
.clubhouse/agents/
.clubhouse/.local/
.clubhouse/agents.json
.clubhouse/agents.json.bak
.clubhouse/settings.local.json

# Claude Code local settings (per-machine permissions/allowlist + local hooks).
# Never a shared artifact; keep it out of the public repo. Shared project config
# (e.g. .claude/commands) can be un-ignored explicitly if it is ever committed.
.claude/settings.local.json

# Local secrets (controller credentials) — never commit
data/secrets.env
data/deploy_hosts.env
data/*.db
data/*.db-wal
data/*.db-shm
scratch_validation/

# LLM investigation dossiers (embed live network topology) — never commit
investigations/

# Environment files — any .env anywhere is treated as secret-bearing.
# Commit a sanitized *.env.example instead (explicitly re-allowed below).
*.env
!*.env.example

# LLM investigator dossiers (netadmin/llm, ARCHITECTURE §10) — contain issue
# evidence, topology context, and device/room names. Local-only.
investigations/

# Generated reports (HTML/PNG/MD tech-visit + morning reports). The whole tree
# is machine output; nothing here is source. Keep docs/ reports out of here.
reports/

# Bundled web UI (built into the package at release; never committed)
netadmin/_webui/

# Python build artifacts (python -m build)
/build/
/dist/
*.egg-info/

# stray local UI captures
.preview-shots/

# home-network / internal docs — kept local, never public
docs/MORNING_REPORT_*.md
docs/PUBLIC_REPO_CHECKLIST.md
deploy/macmini.md
deploy/update-macmini.sh
deploy/artifacts/
.clubhouse/plugin-data-local/

